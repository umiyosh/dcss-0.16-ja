# Deterministic normal-game win for test/orb-endgame.

name = orb_endgame_e2e
map = orb_endgame_d1
species = hu
background = mo
restart_after_game = false
show_more = false
autopickup =

Lua{
local stage = "start"
local trace = ""
local ability_observed = false
local entry_stairs = { }

local function fail(message)
    crawl.stderr("E2E FAIL [" .. stage .. "]: " .. message
        .. "; trace: " .. trace)
    crawl.sendkeys(string.char(17) .. "yes" .. string.char(13))
end

local function advance(next_stage, keys)
    trace = trace .. next_stage .. "@" .. you.where() .. "/"
        .. view.feature_at(0, 0) .. ";"
    stage = next_stage
    crawl.stderr("E2E STAGE [" .. next_stage .. "] on "
        .. you.where() .. "/" .. view.feature_at(0, 0))
    crawl.sendkeys(keys)
end

local function expect_place(expected)
    if not you.where():find(expected, 1, true) then
        fail("expected " .. expected .. ", found " .. you.where())
        return false
    end
    return true
end

local function expect_feature(expected)
    local actual = view.feature_at(0, 0)
    if actual ~= expected then
        fail("expected " .. expected .. ", found " .. actual)
        return false
    end
    return true
end

local function use_ability(name)
    for letter, ability in pairs(you.ability_table()) do
        if ability == name then
            crawl.sendkeys("a" .. letter)
            return true
        end
    end
    return false
end

local up_features = { "stone_stairs_up_i", "stone_stairs_up_ii",
                      "stone_stairs_up_iii" }
local down_features = { "stone_stairs_down_i", "stone_stairs_down_ii",
                        "stone_stairs_down_iii" }

local function remember_entry_stair()
    local place = you.where()
    if entry_stairs[place] ~= nil then return end
    local current = view.feature_at(0, 0)
    for _, feature in ipairs(up_features) do
        if current == feature then
            entry_stairs[place] = current
            return
        end
    end
end

local function find_feature(expected, radius)
    if type(expected) == "string" then expected = { expected } end
    radius = radius or 8
    for _, name in ipairs(expected) do
        for x = -radius, radius do
            for y = -radius, radius do
                if view.feature_at(x, y) == name then
                    return x, y
                end
            end
        end
    end
    return nil, nil
end

local function step_towards(x, y)
    local horizontal = x < 0 and "h" or x > 0 and "l" or ""
    local vertical = y < 0 and "k" or y > 0 and "j" or ""
    local diagonal = { hj = "b", hk = "y", lj = "n", lk = "u" }
    if horizontal ~= "" and vertical ~= "" then
        return diagonal[horizontal .. vertical]
    end
    if horizontal ~= "" then return horizontal end
    return vertical
end

local function approach_feature(expected, radius)
    local x, y = find_feature(expected, radius)
    if x == nil then return false, false end
    if x == 0 and y == 0 then return true, true end
    crawl.sendkeys(step_towards(x, y))
    return true, false
end

local function approach_or_fail(expected, description, radius)
    local found, arrived = approach_feature(expected, radius)
    if not found then fail(description .. " was not found") end
    return found, arrived
end

function ready()
    crawl.enable_more(false)
    remember_entry_stair()
    if stage == "start" then
        if not expect_place("D:1")
            or not expect_feature("exit_dungeon") then
            return
        end
        advance("altar_reached", "h")
    elseif stage == "altar_reached" then
        if not expect_feature("altar_trog") then return end
        advance("joined_trog", "pYY")
    elseif stage == "joined_trog" then
        if you.god() ~= "Trog" then
            return fail("altar prayer did not join Trog")
        end
        stage = "ability_invoked"
        if not use_ability("Berserk") then
            return fail("Berserk ability was unavailable")
        end
    elseif stage == "ability_invoked" then
        if you.berserk() then
            ability_observed = true
            crawl.sendkeys(".")
        elseif ability_observed then
            advance("bazaar_entrance", "h")
        else
            fail("Berserk was not activated")
        end
    elseif stage == "bazaar_entrance" then
        if not expect_feature("enter_bazaar") then return end
        advance("bazaar_entered", ">")
    elseif stage == "bazaar_entered" then
        if not expect_place("Bazaar")
            or not expect_feature("exit_bazaar") then
            return
        end
        advance("bazaar_exited", ">")
    elseif stage == "bazaar_exited" then
        if not expect_place("D:1")
            or not expect_feature("enter_bazaar") then
            return
        end
        advance("lair_entered", "hh>")
    elseif stage == "lair_entered" then
        if not expect_place("Lair:1") then return end
        advance("lair_finding_slime", ".")
    elseif stage == "lair_finding_slime" then
        if not expect_place("Lair:") then return end
        local found, arrived = approach_feature("enter_slime_pits")
        if found then
            if arrived then advance("slime_entered", ">") end
            return
        end
        found, arrived = approach_or_fail(down_features, "down staircase")
        if found and arrived then crawl.sendkeys(">") end
    elseif stage == "slime_entered" then
        if not expect_place("Slime:") then return end
        local found, arrived = approach_feature("stone_arch")
        if found then
            if not arrived then return end
            advance("slime_rune_picked", "g")
            return
        end
        found, arrived = approach_or_fail(down_features,
                                          "Slime down staircase")
        if found and arrived then crawl.sendkeys(">") end
    elseif stage == "slime_rune_picked" then
        if you.num_runes() ~= 1 then
            return fail("expected one rune")
        end
        advance("slime_exiting", ".")
    elseif stage == "slime_exiting" then
        if not expect_place("Slime:") then return end
        local found, arrived = approach_or_fail("exit_slime_pits",
                                                "Slime exit")
        if found and arrived then advance("lair_exiting", "<") end
    elseif stage == "lair_exiting" then
        if not expect_place("Lair:") then return end
        local found, arrived = approach_or_fail("exit_lair", "Lair exit")
        if found and arrived then
            advance("dungeon_finding_vaults", "<")
        end
    elseif stage == "dungeon_finding_vaults" then
        if not expect_place("D:") then return end
        local found, arrived = approach_feature("enter_vaults")
        if found then
            if arrived then advance("vaults_finding_crypt", ">") end
            return
        end
        found, arrived = approach_or_fail(down_features, "Dungeon down staircase")
        if found and arrived then crawl.sendkeys(">") end
    elseif stage == "vaults_entered" then
        if not expect_place("Vaults:") then return end
        local found, arrived = approach_feature("stone_arch")
        if found then
            if not arrived then return end
            advance("vaults_rune_picked", "g")
            return
        end
        found, arrived = approach_or_fail(down_features,
                                          "Vaults down staircase")
        if found and arrived then crawl.sendkeys(">") end
    elseif stage == "vaults_rune_picked" then
        if you.num_runes() ~= 3 then
            return fail("expected three runes")
        end
        advance("vaults_exiting", ".")
    elseif stage == "vaults_exiting" then
        if not expect_place("Vaults:") then return end
        local found, arrived = approach_or_fail("exit_vaults", "Vaults exit")
        if found and arrived then
            advance("dungeon_finding_depths", "<")
        end
    elseif stage == "vaults_finding_crypt" then
        if not expect_place("Vaults:") then return end
        local found, arrived = approach_feature("enter_crypt")
        if found then
            if arrived then advance("crypt_descending", ">") end
            return
        end
        found, arrived = approach_or_fail(down_features,
                                          "Vaults down staircase")
        if found and arrived then crawl.sendkeys(">") end
    elseif stage == "crypt_descending" then
        if not expect_place("Crypt:") then return end
        local found, arrived = approach_feature("enter_tomb")
        if found then
            if arrived then advance("tomb_entered", ">") end
            return
        end
        found, arrived = approach_or_fail(down_features, "Crypt down staircase")
        if found and arrived then crawl.sendkeys(">") end
    elseif stage == "tomb_entered" then
        if not expect_place("Tomb:") then return end
        local found, arrived = approach_feature("stone_arch")
        if found then
            if not arrived then return end
            advance("tomb_rune_picked", "g")
            return
        end
        found, arrived = approach_or_fail(down_features,
                                          "Tomb down staircase")
        if found and arrived then crawl.sendkeys(">") end
    elseif stage == "tomb_rune_picked" then
        if you.num_runes() ~= 2 then
            return fail("expected two runes")
        end
        advance("tomb_exiting", ".")
    elseif stage == "tomb_exiting" then
        if not expect_place("Tomb:") then return end
        local found, arrived = approach_or_fail("exit_tomb", "Tomb exit")
        if found and arrived then advance("crypt_exiting", "<") end
    elseif stage == "crypt_exiting" then
        if not expect_place("Crypt:") then return end
        local found, arrived = approach_or_fail("exit_crypt", "Crypt exit")
        if found and arrived then advance("vaults_entered", "<") end
    elseif stage == "dungeon_finding_depths" then
        if not expect_place("D:") then return end
        local found, arrived = approach_feature("enter_depths")
        if found then
            if arrived then advance("depths_descending", ">") end
            return
        end
        found, arrived = approach_or_fail(down_features, "Dungeon down staircase")
        if found and arrived then crawl.sendkeys(">") end
    elseif stage == "depths_descending" then
        if not expect_place("Depths:") then return end
        local depth = tonumber(you.where():match("Depths:(%d+)"))
        if depth == 5 then
            local found, arrived = approach_or_fail("enter_zot", "Zot gate")
            if found and arrived then advance("zot_entered", ">") end
            return
        end
        local found, arrived = approach_or_fail(down_features,
                                                "Depths down staircase")
        if found and arrived then crawl.sendkeys(">") end
    elseif stage == "zot_entered" then
        if not expect_place("Zot:") then return end
        local found, arrived = approach_feature("stone_arch")
        if found then
            if not arrived then return end
            advance("orb_picked", "gY")
            return
        end
        found, arrived = approach_or_fail(down_features,
                                          "Zot down staircase")
        if found and arrived then crawl.sendkeys(">") end
    elseif stage == "orb_picked" then
        if not you.have_orb() then return fail("Orb was not picked up") end
        crawl.dump_char()
        advance("zot_exiting", ".")
    elseif stage == "zot_exiting" then
        if not expect_place("Zot:") then return end
        local found, arrived = approach_or_fail("exit_zot", "Zot exit")
        if found and arrived then advance("depths_exiting", "<") end
    elseif stage == "depths_exiting" then
        if not expect_place("Depths:") then return end
        local found, arrived = approach_or_fail("exit_depths", "Depths exit")
        if found and arrived then
            advance("dungeon_ascending", "<")
        end
    elseif stage == "dungeon_ascending" then
        if not expect_place("D:") then return end
        if you.where() == "D:1" then
            local found, arrived = approach_or_fail("exit_dungeon",
                                                    "Dungeon exit")
            if found and arrived then
                crawl.stderr("E2E PASS: three-rune Orb escape")
                crawl.sendkeys("<")
            end
            return
        end
        if you.where() == "D:8"
            and view.feature_at(0, 0) == "stone_stairs_down_iii" then
            crawl.sendkeys("o")
            return
        end
        local target = entry_stairs[you.where()] or up_features
        local radius = you.where() == "D:8" and 12 or 8
        local found, arrived = approach_or_fail(target,
                                                "Dungeon up staircase", radius)
        if found and arrived then crawl.sendkeys("<") end
    else
        fail("unknown stage")
    end
end
}
