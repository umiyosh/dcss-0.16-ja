#!/bin/sh
set -eu

fail()
{
    echo "Orb end-game test failed: $*" >&2
    echo "artifacts: $test_root" >&2
    if [ -n "${log_file:-}" ] && [ -f "$log_file" ]; then
        tail -n 60 "$log_file" >&2
    fi
    exit 1
}

if [ -n "${ORB_TEST_ROOT:-}" ]; then
    test_root=$ORB_TEST_ROOT
else
    test_root=$(mktemp -d "${TMPDIR:-/tmp}/dcss-orb-endgame.XXXXXX")
fi

platform=$(uname -s)
if [ "$platform" = Darwin ] && [ -z "${ORB_TEST_SHARED_DIR:-}" ]; then
    fail "macOS requires ORB_TEST_SHARED_DIR and a matching SHAREDDIR build"
fi

save_dir=$test_root/saves
morgue_dir=$test_root/morgue
shared_dir=${ORB_TEST_SHARED_DIR:-$save_dir}
score_file=$shared_dir/scores
log_file=$test_root/orb-endgame.log

mkdir -p "$save_dir" "$morgue_dir" "$shared_dir"
./crawl --version > "$test_root/version.txt"
printf '%s\n' \
    'seed: 1' \
    'command: make test-orb-endgame' \
    'rc: test/orb-endgame.rc' > "$test_root/run.txt"

if command -v timeout >/dev/null 2>&1; then
    timelimit="timeout 120"
elif command -v gtimeout >/dev/null 2>&1; then
    timelimit="gtimeout 120"
else
    timelimit=""
fi

if ! $timelimit ./util/fake_pty ./crawl \
        -seed 1 \
        -no-throttle \
        -dir "$test_root" \
        -morgue "$morgue_dir" \
        -extra-opt-last "save_dir=$save_dir" \
        -rc test/orb-endgame.rc > "$log_file" 2>&1; then
    fail "Crawl did not exit normally"
fi

grep -a -q 'E2E PASS: three-rune Orb escape' "$log_file" \
    || fail "completion marker was not emitted"
[ -f "$score_file" ] || fail "score file was not generated"
grep -a -E 'name=orb_endgame_e2e:.*:ktyp=winning(:|$)' "$score_file" \
    | grep -a -q ':nrune=3:' \
    || fail "three-rune win was not recorded in the score file"

morgue_file=""
for candidate in "$morgue_dir"/morgue-orb_endgame_e2e-*.txt; do
    if [ -f "$candidate" ]; then
        [ -z "$morgue_file" ] || fail "multiple final morgue files found"
        morgue_file=$candidate
    fi
done
[ -n "$morgue_file" ] || fail "final morgue file was not generated"

for save_file in "$save_dir"/*.cs; do
    [ ! -e "$save_file" ] || fail "resumable save remains: $save_file"
done

echo "Orb end-game test passed"
echo "artifacts: $test_root"
echo "morgue: $morgue_file"
