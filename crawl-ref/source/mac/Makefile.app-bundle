# [ds] We all knew make's handling of embedded spaces is demented, but
# I had no idea just how demented it is.

CRAWL_BASE=$(CURDIR)/../..
CRAWL_SRC=$(CRAWL_BASE)/source

ZIP_QUALIFIER :=
ZIP_ARCH :=

ifdef BUILD_UNIVERSAL
ZIP_ARCH := -universal
endif

APP_NAME := Dungeon Crawl Stone Soup
ifneq (,$(findstring tiles,$(MAKECMDGOALS)))
BUNDLE_NAME := Dungeon\ Crawl\ Stone\ Soup\ -\ Tiles
TILE_APP := y
ifdef RELEASE
ZIP_QUALIFIER := -tiles
else
ZIP_QUALIFIER := _tiles
endif
EXECUTABLE_PATH := $(CRAWL_SRC)/crawl
else
BUNDLE_NAME := Dungeon\ Crawl\ Stone\ Soup\ -\ Console
EXECUTABLE_PATH := crawl
ifdef RELEASE
ZIP_QUALIFIER := -console
endif
endif

ifdef RELEASE
ZIP_NAME = stone_soup-$(SRC_VERSION)$(ZIP_QUALIFIER)-macosx.zip
else
ZIP_NAME = crawl$(ZIP_QUALIFIER)_osx-$(SRC_VERSION).zip
endif

STAGING_DIR := $(CRAWL_SRC)/build/app-bundle-stage
ZIPPED_APP_DIR := $(CRAWL_SRC)/mac-app-zips
BUNDLE_DIRNAME := $(STAGING_DIR)/$(BUNDLE_NAME).app
RESOURCES := $(BUNDLE_DIRNAME)/Contents/Resources
FRAMEWORKS := $(BUNDLE_DIRNAME)/Contents/Frameworks

# The binary the bundled libraries have to resolve against. For tiles that is
# the bundle executable; the console bundle runs the copy in Resources through
# a launcher script, so @executable_path points there instead. Either way
# @executable_path/../Frameworks lands on Contents/Frameworks.
ifdef TILE_APP
BUNDLED_BINARY := $(BUNDLE_DIRNAME)/Contents/MacOS/$(BUNDLE_NAME)
else
BUNDLED_BINARY := $(RESOURCES)/crawl
endif

.PHONY: all clean clean-stage stage-dir copy-executable copy-resources \
	copy-tiledata assemble-app-bundle create-bundle-directory \
	bundle-dylibs sign-app-bundle

all: $(STAGING_DIR) $(ZIPPED_APP_DIR) \
	clean-stage assemble-app-bundle zip-app-bundle

clean:
	rm -rf $(CRAWL_SRC)/build

tiles: all

$(STAGING_DIR):
	mkdir -p $@

$(ZIPPED_APP_DIR):
	mkdir -p $@

clean-stage:
	rm -rf $(STAGING_DIR)/*

# No notarization here on purpose. That needs the Developer ID credentials,
# and this target runs on every build including untrusted branches, so it must
# stay usable without any secret. mac/notarize-app.sh does the notarizing, and
# only the release workflow's signing job — gated on a trusted ref — calls it.
assemble-app-bundle: create-bundle-directory copy-executable copy-resources \
		     copy-info-plist bundle-dylibs sign-app-bundle

# ditto rather than zip: it is what Apple documents for notarization
# submissions, and it round-trips bundle metadata that zip can mangle.
zip-app-bundle:
	rm -f $(ZIPPED_APP_DIR)/$(ZIP_NAME)
	ditto -c -k --keepParent $(BUNDLE_DIRNAME) $(ZIPPED_APP_DIR)/$(ZIP_NAME)

create-bundle-directory: $(BUNDLE_DIRNAME)

$(BUNDLE_DIRNAME):
	mkdir -p "$@"/Contents/{MacOS,Resources,Frameworks}

# The console Crawl bundle has a shell script launcher that uses the
# real executable from Contents/Resources, so an extra copy for the wrapper+
# real thing.
copy-executable:
	cp $(EXECUTABLE_PATH) $(BUNDLE_DIRNAME)/Contents/MacOS/$(BUNDLE_NAME)
ifndef TILE_APP
	cp $(CRAWL_SRC)/crawl $(RESOURCES)
endif

# contrib/fonts used to be copied into Contents/MacOS here. It held the two
# DejaVu faces, which contain no CJK glyphs and so cannot render a single
# string this fork displays; the font actually loaded is the bundled HackGen
# in dat/tiles, found through datafile_path. Nothing referenced the copy, and
# non-code files under Contents/MacOS make the bundle fail codesign.
copy-resources:
	cp $(CRAWL_SRC)/mac/Crawl.icns $(RESOURCES)
	cp -r $(CRAWL_BASE)/settings $(RESOURCES)
	cp -r $(CRAWL_SRC)/dat $(RESOURCES)
	cp -r $(CRAWL_BASE)/docs $(RESOURCES)
	cp $(CRAWL_BASE)/licence.txt $(RESOURCES)/LICENCE.txt
	cp $(CRAWL_BASE)/README.txt $(RESOURCES)
	cp $(CRAWL_BASE)/CREDITS.txt $(RESOURCES)
	rm -rf $(RESOURCES)/docs/obsolete
	rm -rf $(RESOURCES)/docs/template
	rm -f $(RESOURCES)/docs/*.html
	rm -f $(RESOURCES)/docs/*.pdf
	rm -f $(RESOURCES)/docs/*.reST
	rm -f $(RESOURCES)/docs/crawl.6
	rm -f $(RESOURCES)/*.png

# A tiles build links SDL2, SDL2_image and FreeType from wherever the build
# machine keeps them, which for most people is Homebrew. Copy that whole
# dependency tree into the bundle so the .app runs somewhere else too.
# Unquoted on purpose: BUNDLE_NAME already carries the backslash escapes the
# shell needs, the same way every other recipe here spells it.
bundle-dylibs:
	perl $(CRAWL_SRC)/mac/bundle-dylibs.pl $(BUNDLED_BINARY) $(FRAMEWORKS)

# Ad-hoc unless MACOS_SIGN_IDENTITY names a real one, in which case the
# bundle also gets the hardened runtime and a secure timestamp so it can be
# notarized. install_name_tool has invalidated the executable's signature by
# this point, so this is also what makes it loadable again.
sign-app-bundle:
	$(CRAWL_SRC)/mac/sign-app.sh $(BUNDLE_DIRNAME)
	@leaks=`find $(BUNDLE_DIRNAME) -type f \( -perm +111 -o -name '*.dylib' \) \
	          -exec otool -L {} + 2>/dev/null \
	        | grep -E '/opt/homebrew|/usr/local/' || true`; \
	if [ -n "$$leaks" ]; then \
		echo "$$leaks" 1>&2; \
		echo "error: the bundle references libraries outside itself" 1>&2; \
		exit 1; \
	fi
	@echo "  bundle is self-contained"

copy-info-plist:
	perl -lpe "s/%VERSION%/$(SRC_VERSION)/g;" \
	     -e "s/%NAME%/$(APP_NAME)/g;" \
	     -e "s/%YEAR%/(localtime)[5] + 1900/ge;" \
	     -e "s/%EXECUTABLE%/$(BUNDLE_NAME)/g;" \
	     Crawl-Info.plist >$(BUNDLE_DIRNAME)/Contents/Info.plist
